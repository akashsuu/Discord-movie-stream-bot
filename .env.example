# ==============================================================================
#  COQUETTE DISCORD STREAM BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Discord Bot Token (from Discord Developer Portal > Bot > Reset Token)
BOT_TOKEN=your_discord_bot_token_here

# Discord Account User Token (for the user account joining voice & sharing screen)
USER_TOKEN=your_discord_user_token_here

# Target Server (Guild) ID
GUILD_ID=1474805625018913043

# Default Voice Channel ID to join
VOICE_CHANNEL_ID=1499087387320651919

# Command Prefix (e.g. .movie, .stream, .help)
PREFIX=.

# TMDB API Key (v3 auth key for movie/series metadata search)
TMDB_API_KEY=15d2ea6d0dc1d476efbca3eba2b9bbfb

# Optional: HTTP/HTTPS proxy URLs for TMDB (comma-separated, for regions where api.themoviedb.org is blocked)
TMDB_PROXIES=

# ==============================================================================
#  LINUX VPS / XVFB / CHROMIUM CONFIGURATION
# ==============================================================================
# X11 Display (default :99 for Xvfb)
DISPLAY=:99

# PulseAudio Virtual Sink name for sound capture
PULSE_SINK=Virtual_Sink

# Path to Chromium binary (e.g. /usr/bin/chromium or auto-detected)
BROWSER_PATH=/usr/bin/chromium

# Headless mode: Must be false for Discord tab capture and video rendering
HEADLESS=false

# Tab capture title match keyword
TAB_CAPTURE_KEYWORD=Stream

# Path to persistent Chrome/Playwright user profile directory
USER_DATA_DIR=./browser-profile
